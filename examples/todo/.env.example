# Copy to .env (Bun loads it automatically).
BAZIS_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL (src/app/config/db.config.ts). Defaults shown; production
# requires BAZIS_DB__PASSWORD and uses tls=verify-full.
BAZIS_DB__HOST=127.0.0.1
BAZIS_DB__PORT=5432
BAZIS_DB__DATABASE=todo
BAZIS_DB__USERNAME=postgres
BAZIS_DB__PASSWORD=postgres
