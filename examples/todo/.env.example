# Copy to .env (Bun loads it automatically).
OSNV_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL (src/app/config/db.config.ts). Defaults shown; production
# requires OSNV_DB__PASSWORD and uses tls=verify-full.
OSNV_DB__HOST=127.0.0.1
OSNV_DB__PORT=5432
OSNV_DB__DATABASE=todo
OSNV_DB__USERNAME=postgres
OSNV_DB__PASSWORD=postgres
